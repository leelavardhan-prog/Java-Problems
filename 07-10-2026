import java.util.*;

class CodeChef {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {
            int N = sc.nextInt();
            int M = sc.nextInt();

            String S = sc.next();
            String L = sc.next();

            int count = 1;
            int max = 1;

            for (int i = 1; i < N; i++) {

                boolean same1 = L.indexOf(S.charAt(i - 1)) >= 0;
                boolean same2 = L.indexOf(S.charAt(i)) >= 0;

                if (same1 == same2) {
                    count++;
                } else {
                    count = 1;
                }

                max = Math.max(max, count);
            }

            System.out.println(max);
        }
    }
}
