import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        int m1 = scan.nextInt();
        int m2 = scan.nextInt();
        int m3 = scan.nextInt();
        int sum = m1 + m2 + m3;
        if (m1 >= 40 && m2 >= 40 && m3 >= 40) {
            System.out.println("PASS");
        } 
        else {
            int count = 0;
            if (m1 < 40) count++;
            if (m2 < 40) count++;
            if (m3 < 40) count++;
            if (count == 1 &&
                m1 >= 35 && m2 >= 35 && m3 >= 35 &&
                sum >= 150) {
                System.out.println("GRACE PASS");
            } 
            else {
                System.out.println("FAIL");
            }
        }
        scan.close();
    }
}
