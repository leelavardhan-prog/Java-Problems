class Solution {
    public int countRotations(String s, int k) {
        int n=s.length();
        int ans=0;
        for(int start=0;start<n;start++){
            int score=0;
            for(int i=0;i<n-1;i++){
                int curr=(start+i)%n;
                int next=(start+i+1)%n;
                if(s.charAt(curr)==s.charAt(next)){
                    score++;
                }
            }
            if(score==k){
                ans++;
            }
        }
        return ans;
    }
}
