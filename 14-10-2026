import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
		Scanner scan=new Scanner(System.in);
		int t=scan.nextInt();
		while(t-- >0){
		    int n=scan.nextInt();
		    int[] a=new int[n];
		    for(int i=0;i<n;i++){
		        a[i]=scan.nextInt();
		    }
		    if(n<=2){
		        System.out.println(0);
		    }
		    else{
		        Arrays.sort(a);
		        int ans=Math.min(
		            a[n-1]-a[1],
		            a[n-2]-a[0]
		            );
		        System.out.println(ans);
		    }
		}
		scan.close();
	}
}
