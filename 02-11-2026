import java.util.Scanner;
public class Main{
    public static void main(String[]args){
        Scanner scan=new Scanner(System.in);
        int n=scan.nextInt();
        long[]arr=new long[n];
        for(int i=0;i<n;i++){
            arr[i]=scan.nextLong();
        }
        int mid = n / 2;

for (int i = 0; i < mid / 2; i++) {
    long temp = arr[i];
    arr[i] = arr[mid - 1 - i];
    arr[mid - 1 - i] = temp;
}

for (int i = 0; i < n; i++) {
    System.out.print(arr[i] + " ");
}
    }
}
