class Solution {
    public int[] maxSlidingWindow(int[] nums, int k) {
        int size = nums.length , trav = 0;
        int[] res=new int[size-k+1];
        Deque<Integer> dq = new ArrayDeque<>();
        for(int ind=0;ind<size;ind++){
            while(!dq.isEmpty()&&dq.peekFirst()<=ind-k)
            dq.pollFirst();
            while(!dq.isEmpty()&&nums[dq.peekLast()]<nums[ind])
            dq.pollLast();
            dq.offer(ind);
            if(ind>=k-1)
            {res[trav]=nums[dq.peekFirst()];trav++;}
        }
        return res;
    }
}
