import java.util.Scanner;
public class main {
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int count=0;
        for(int i=0;i<n&&sc.hasNextInt();i++){
            int num=sc.nextInt();
            if(isFibonacci(num)){
                count++;
            }
        }
        if(count>=2){
            System.out.println(count);
        } else{
            System.out.println(-1);
        }
        sc.close();
    }
    static boolean isFibonacci(int num){
        int a=0;
        int b=1;
        while (a<num) {
            int c=a+b;
            a=b;
            b=c;
        }
        return a==num;
    }
}
