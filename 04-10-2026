class Solution {
    public int minRotations(int n, String s) {
        int[] pre=new int[n];
        int[] suf=new int[n];
        pre[0]=dist(0,s.charAt(0)-'0');
        for(int i=1;i<n;i++){
            pre[i]=pre[i-1]+dist(s.charAt(i-1)-'0',s.charAt(i)-'0');
        }
        suf[n-1]=0;
        for(int i=n-2;i>=0;i--){
            suf[i]=suf[i+1]+dist(s.charAt(i)-'0',s.charAt(i+1)-'0');
        }
        int ans=pre[n-1];
        for(int k=0;k<n;k++){
            int cost;
            if(k==0){
                cost=dist(0,s.charAt(n-1)-'0')+suf[0];
            }
            else{
                int precost=pre[k-1];
                int con=dist(s.charAt(k-1)-'0',s.charAt(n-1)-'0');
                int sufcost=suf[k];
                cost=precost+con+sufcost;
            }
            ans=Math.min(ans,cost);
        }
        return ans;
        }
    private int dist (int a,int b){
        int d=Math.abs(a-b);
        return Math.min(d,10-d);
    }
